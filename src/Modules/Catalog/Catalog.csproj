<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>2655ab46-1003-46e7-9398-a915f7063404</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <Folder Include="Domain\ValueObjects\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
      <PackageReference Include="MassTransit" Version="8.5.11" />
      <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.11" />
      <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.11" />
      <PackageReference Include="MediatR" Version="14.1.0" />
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
      <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Catalog.UnitTests" />
      <InternalsVisibleTo Include="Catalog.IntegrationTests" />
      <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.csproj" />
      <ProjectReference Include="..\Ai.Contracts\Ai.Contracts.csproj" />
      <ProjectReference Include="..\Catalog.Contracts\Catalog.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
